{
  "name": "fsda-cloud-functions",
  "private": true,
  "main": "lib/functions/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "npm run typecheck && esbuild index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=lib/functions/index.js --external:firebase-admin --external:firebase-functions",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test rewardValidation.test.ts"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  }
}